        allow create: if canWriteModule(departmentId, "hydrants");
        allow update, delete: if canManageModule(departmentId, "hydrants", hydrantAdminKeys());
      }
      match /hydrantOwnershipReview/{reviewId} {
        allow read: if canAccessDepartment(departmentId);
        allow create, update: if canManageModule(departmentId, "hydrants", hydrantDamageWorkKeys())
          || canManageModule(departmentId, "hydrants", hydrantAdminKeys());
        allow delete: if canManageModule(departmentId, "hydrants", hydrantAdminKeys());
      }
      match /hydrantDamageReports/{reportId} {
        allow read: if canAccessDepartment(departmentId);
        allow create, update: if canManageModule(departmentId, "hydrants", hydrantDamageWorkKeys());
        allow delete: if canManageModule(departmentId, "hydrants", hydrantAdminKeys());
      }
      // Hydrants and their test records: crews with hydrant access record; only
      // hydrant admins delete. (Which hydrant fields a crew may change is checked in the app.)
      match /hydrants/{hydrantId} {
        allow read: if canAccessDepartment(departmentId);
        allow create, update: if canManageModule(departmentId, "hydrants", hydrantFieldKeys());
        allow delete: if canManageModule(departmentId, "hydrants", hydrantAdminKeys());
      }
      match /hydrantInspections/{recordId} {
        allow read: if canAccessDepartment(departmentId);
        allow create, update: if canManageModule(departmentId, "hydrants", hydrantFieldKeys());
        allow delete: if canManageModule(departmentId, "hydrants", hydrantAdminKeys());
      }
      match /hydrantFlowTests/{recordId} {
        allow read: if canAccessDepartment(departmentId);
        allow create, update: if canManageModule(departmentId, "hydrants", hydrantFieldKeys());
        allow delete: if canManageModule(departmentId, "hydrants", hydrantAdminKeys());
      }
      match /dailyActivity/{recordId} {
        allow read: if canAccessDepartment(departmentId);
        allow create, update: if canManageModule(departmentId, "hydrants", hydrantFieldKeys());
        allow delete: if canManageModule(departmentId, "hydrants", hydrantAdminKeys());
      }
      match /hydrantDamageEmailAttempts/{attemptId} {
        allow read: if canAccessDepartment(departmentId);
        allow create, update: if canWriteModule(departmentId, "hydrants");
        allow delete: if false;
      }
      match /hydrantDamageAcknowledgments/{ackId} {
        allow read: if canAccessDepartment(departmentId);
        allow create: if canWriteModule(departmentId, "hydrants");
        allow update, delete: if false;
      }
      match /hydrantRepairVerifications/{verificationId} {
        allow read: if canAccessDepartment(departmentId);
        allow create: if canWriteModule(departmentId, "hydrants");
        allow update, delete: if false;
      }
      match /hydrantDamageAuditEvents/{eventId} {
        allow read: if canAccessDepartment(departmentId);
        allow create: if canWriteModule(departmentId, "hydrants");
        allow update, delete: if false;
      }
      // Fallback for tenant collections without an explicit rule above.
      match /{collection}/{document} {
        allow read: if !hasExplicitTenantRule(collection) && canAccessDepartment(departmentId);
        allow write: if !hasExplicitTenantRule(collection)
          && canWriteModule(departmentId, collectionModule(collection));
      }
    }

    match /hydrantDamageAckTokens/{tokenId} {
      allow read, write: if false;
    }

    // Legacy Horn Lake prototype collections. The app now uses
    // departments/{id}/<same name>; these are kept read-only for Horn Lake
    // until their data is moved (Phase 2), then they will be closed.
    match /preFirePlans/{document} {
      allow read: if canReadLegacyHornLakeData();
      allow write: if isPlatformCreator();
    }

    match /hydrants/{document} {
      allow read: if canReadLegacyHornLakeData();
      allow write: if isPlatformCreator();
    }

    match /hydrantInspections/{document} {
      allow read: if canReadLegacyHornLakeData();
      allow write: if isPlatformCreator();
    }

    match /hydrantFlowTests/{document} {
      allow read: if canReadLegacyHornLakeData();
      allow write: if isPlatformCreator();
    }

    match /dailyActivity/{document} {
      allow read: if canReadLegacyHornLakeData();
      allow write: if isPlatformCreator();
    }

    match /hoseTests/{document} {
      allow read: if canReadLegacyHornLakeData();
      allow write: if isPlatformCreator();
    }
  }
}
