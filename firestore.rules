rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // App reference datasets: EMS protocols, SOG indexes/details, fire code indexes, hose inventory.
    match /appData/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{collection}/{document} {
      allow read: if collection in [
        "emsProtocolsFull",
        "fireSogsFull",
        "fireSogDetails",
        "fireCodesFull",
        "fireCodeIndexFull",
        "fireCodePdfSections",
        "fireCodeDocxSections",
        "hoseInventory"
      ];
      allow write: if request.auth != null && collection in [
        "emsProtocolsFull",
        "fireSogsFull",
        "fireSogDetails",
        "fireCodesFull",
        "fireCodeIndexFull",
        "fireCodePdfSections",
        "fireCodeDocxSections",
        "hoseInventory"
      ];
    }

    // Pre-fire plan metadata. Keep writes authenticated once department logins are enabled.
    match /preFirePlans/{document} {
      allow read: if true;
      allow write: if true;
    }

    match /hydrants/{document} {
      allow read, write: if true;
    }

    match /hydrantInspections/{document} {
      allow read, write: if true;
    }

    match /hydrantFlowTests/{document} {
      allow read, write: if true;
    }

    match /dailyActivity/{document} {
      allow read, write: if true;
    }

    match /hoseTests/{document} {
      allow read, write: if true;
    }
  }
}
