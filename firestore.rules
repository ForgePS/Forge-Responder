      match /notifications/{notificationId} {
        allow read: if canAccessDepartment(departmentId);
        allow create: if canAccessDepartment(departmentId);
        // Marking read only.
        allow update: if canAccessDepartment(departmentId)
          && changedKeys().hasOnly(["status", "readAt", "read_at", "updatedAt"]);
        allow delete: if isDepartmentAdmin(departmentId);
      }
