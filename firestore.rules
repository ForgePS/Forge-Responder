rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Platform creators are listed in platformCreators/{uid}, which only the
    // server/console can write. No email allowlists.
    // Signed in with a two-factor (authenticator app) code this session.
    function hasSecondFactor() {
      return request.auth != null
        && request.auth.token.get("firebase", {}).get("sign_in_second_factor", null) != null;
    }

    // Two-step sign-in codes are optional (2026-10-29): nobody is required to use
    // them. These helpers stay so the requirement can be switched back on in one place.
    function adminTwoFactorDeadlinePassed() {
      return exists(/databases/$(database)/documents/platformConfig/main)
        && get(/databases/$(database)/documents/platformConfig/main).data.get("mfaAdminDeadline", null) != null
        && request.time >= get(/databases/$(database)/documents/platformConfig/main).data.mfaAdminDeadline;
    }
    function adminTwoFactorOk(departmentId) {
      return true;
    }

    // Platform creators: an active platformCreators/{uid} record (two-step code optional).
    function isPlatformCreator() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/platformCreators/$(request.auth.uid))
        && get(/databases/$(database)/documents/platformCreators/$(request.auth.uid)).data.status == "active";
    }

    function isDepartmentMember(departmentId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/departments/$(departmentId)/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/departments/$(departmentId)/users/$(request.auth.uid)).data.status == "active";
    }

    function isDemoDepartment(departmentId) {
      return departmentId == "forge-demo";
    }

    // The shared demo login (its password is shown on the public demo page). Only this
    // account, demo members and platform creators use forge-demo; other signed-in
    // users no longer get in just by being signed in.
    function isDemoAccount() {
      return isAuthenticated() && request.auth.token.get("email", "") == "demo@forge.demo";
    }

    // A department is usable unless its subscription is suspended/cancelled or the
    // registry marks it disabled/archived. Both docs are creator-only writes.
    function isDepartmentActive(departmentId) {
      return (
          !exists(/databases/$(database)/documents/platformSubscriptions/$(departmentId))
          || !(get(/databases/$(database)/documents/platformSubscriptions/$(departmentId)).data.get("status", "") in ["suspended", "cancelled"])
        )
        && (
          !exists(/databases/$(database)/documents/platformDepartments/$(departmentId))
          || !(get(/databases/$(database)/documents/platformDepartments/$(departmentId)).data.get("status", "") in ["disabled", "archived"])
        );
    }

    function membershipData(departmentId) {
      return get(/databases/$(database)/documents/departments/$(departmentId)/users/$(request.auth.uid)).data;
    }

    // Department admin = active member of an active department holding an admin role
    // (same definition as functions/lib/invites.js). Custom roles that grant
    // manageUsers are not recognised here.
    function isDepartmentAdmin(departmentId) {
      return isPlatformCreator() || (
        isDepartmentMember(departmentId)
        && isDepartmentActive(departmentId)
        && adminTwoFactorOk(departmentId)
        && (
          membershipData(departmentId).get("role", "") in ["department_admin"]
          || membershipData(departmentId).get("roleIds", []).hasAny(["fireChief", "itAdmin"])
        )
      );
    }

    // Fields that mark a membership as platform-level. Only platform creators may set them.
    function touchesPlatformFlags(data) {
      return data.get("isPlatformCreator", false) == true
        || data.get("role", "") == "creator"
        || data.get("roleIds", []).hasAny(["creator"]);
    }

    // Department admins may change someone's role(s), but never to or from the
    // platform "creator" role or flag.
    function platformFlagsUnchanged() {
      return request.resource.data.get("isPlatformCreator", false) == resource.data.get("isPlatformCreator", false)
        && (request.resource.data.get("role", "") == "creator") == (resource.data.get("role", "") == "creator")
        && request.resource.data.get("roleIds", []).hasAny(["creator"]) == resource.data.get("roleIds", []).hasAny(["creator"]);
    }

    // A member may edit only their own profile/preference fields — never role, roleIds,
    // status, departmentId, platform flags or personnelId. The personnel link is set by
    // an admin or by the linkMyPersonnelRecord function (matched by verified email).
    function isSafeSelfMembershipUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "preferences", "updatedAt", "lastLoginAt", "displayName", "uid"
        ])
        && request.resource.data.get("uid", request.auth.uid) == request.auth.uid;
    }

    function canAccessDepartment(departmentId) {
      return isPlatformCreator()
        || (isDepartmentMember(departmentId) && isDepartmentActive(departmentId))
        || (isDemoAccount() && isDemoDepartment(departmentId));
    }

    // ---- Plan entitlements (written only by Cloud Functions; functions/lib/entitlements.js) ----
    // Missing record or field = not enforced yet, so nothing changes until the
    // server has written a department's entitlements.
    function entitlementsPath(departmentId) {
      return /databases/$(database)/documents/platformEntitlements/$(departmentId);
    }
    function entitlementsData(departmentId) {
      return get(entitlementsPath(departmentId)).data;
    }
    function moduleOn(departmentId, moduleKey) {
      return moduleKey == ""
        || !exists(entitlementsPath(departmentId))
        || !("modules" in entitlementsData(departmentId))
        || moduleKey in entitlementsData(departmentId).modules;
    }
    // Writing a module's data needs the module switched on (creators exempt).
    function canWriteModule(departmentId, moduleKey) {
      return canAccessDepartment(departmentId) && (isPlatformCreator() || moduleOn(departmentId, moduleKey));
    }
    // ---- Member permissions (batch 5) ----
    // departments/<id>/memberGrants/<uid>.permissions holds the member's granted
    // permission keys (true only), kept by Cloud Functions (functions/lib/memberGrants.js)
    // from their roles and personal overrides, the same way the app works them out.
    function grantPath(departmentId) {
      return /databases/$(database)/documents/departments/$(departmentId)/memberGrants/$(request.auth.uid);
    }
    // Holds at least one of the permission keys. Platform creators, department
    // admins and the shared demo account in forge-demo always pass.
    function memberCanAny(departmentId, keys) {
      return isPlatformCreator()
        || isDepartmentAdmin(departmentId)
        || (isDemoAccount() && isDemoDepartment(departmentId))
        || (exists(grantPath(departmentId))
            && get(grantPath(departmentId)).data.get("permissions", {}).keys().hasAny(keys));
    }
    // Write a module's data AND hold one of the permissions for it.
    function canManageModule(departmentId, moduleKey, keys) {
      return canWriteModule(departmentId, moduleKey) && memberCanAny(departmentId, keys);
    }
    // Permission groups used by the module rules below.
    function inspectionWorkKeys() {
      return ["editInspections", "conductInspections", "approveInspections", "editViolations",
        "editInspectionNotices", "manageInspectionDocuments", "editInspectionEnforcement",
        "editFireProtectionSystems", "editInspectionFees", "editInspectionReports",
        "manageInspectionConfig", "manageInspectionOffline", "manageInspectionAutomation",
        "manageInspectionHardening"];
    }
    function inspectionConfigKeys() {
      return ["manageInspectionConfig", "manageSystemSettings"];
    }
    function codeLibraryKeys() {
      return ["manageCodeLibrary", "manageAdoptedCodes", "manageInspectionConfig"];
    }
    function preplanWorkKeys() {
      return ["editPreplans", "createPreplans", "approvePreplans", "managePreplanConfig", "editInspections"];
    }
    function preplanApproveKeys() {
      return ["approvePreplans", "managePreplanConfig"];
    }
    function preplanConfigKeys() {
      return ["managePreplanConfig", "manageInspectionConfig", "manageSystemSettings"];
    }
    function preplanRestrictedReadKeys() {
      return ["viewPreplanSensitive", "viewPreplanKnox", "viewPreplanUtilities", "viewPreplanHazmat",
        "approvePreplans", "managePreplanConfig", "editPreplans", "createPreplans"];
    }
    function fleetWorkKeys() {
      return ["editApparatus", "editFleetAssets", "manageFleetConfig", "conductFleetChecks", "editFleetDefects",
        "manageFleetStatus", "editFleetWorkOrders", "editFleetPm", "editFleetTests", "editFleetFuel",
        "editFleetTelematics", "editFleetComponents", "editFleetOperations", "editFleetRisk",
        "editFleetProcurement", "editFleetCost", "editFleetReporting", "editFleetVendorPortal"];
    }
    function fleetConfigKeys() {
      return ["manageFleetConfig", "editFleetAssets", "editApparatus", "manageSystemSettings"];
    }
    function hydrantAdminKeys() {
      return ["manageWaterCompanies", "manageWaterDistricts", "editHydrants", "manageSystemSettings"];
    }
    // Crews record hydrant tests and inspections (which also update the hydrant).
    function hydrantFieldKeys() {
      return ["viewHydrants", "editHydrants", "manageSystemSettings"];
    }
    function hydrantDamageWorkKeys() {
      return ["createHydrantDamageReports", "editHydrantDamageDrafts", "sendHydrantDamageReports",
        "verifyHydrantDamageReports", "acknowledgeHydrantDamageReports", "escalateHydrantDamageReports",
        "editHydrants", "manageSystemSettings"];
    }

    // ---- Lists: who may change what ----
    // The personnel record a member is linked to ("" if not linked yet).
    function myPersonnelId(departmentId) {
      return membershipData(departmentId).get("personnelId", "");
    }
    function scheduleManageKeys() {
      return ["editSchedule", "manageSystemSettings", "editPersonnel"];
    }
    // Which permission group lets someone change ANY item in a list. Lists not
    // named here keep the module check only.
    function listGroup(listKey) {
      return {
        "hlfd-rms-personnel": "personnel",
        "hlfd-rms-certifications": "certifications",
        "hlfd-rms-training": "training",
        "hlfd-rms-schedule-days": "schedule",
        "hlfd-rms-roster": "schedule",
        "hlfd-rms-leave-requests": "schedule",
        "hlfd-rms-overtime-offers": "schedule",
        "hlfd-rms-vacancy-pickups": "schedule",
        "hlfd-rms-shift-trades": "schedule",
        "hlfd-rms-call-shifts": "schedule",
        "hlfd-rms-time-cards": "timeCards",
        "hlfd-rms-daily-logs": "dailyLog",
        "hlfd-rms-apparatus": "apparatus",
        "hlfd-rms-assets": "assets",
        "hlfd-rms-work-orders": "workOrders",
        "hlfd-rms-hose-tests": "hoseTests",
        "hlfd-rms-occupancies": "occupancies",
        "hlfd-rms-inspections": "inspections",
        "hlfd-rms-preplans": "preplans",
        "hlfd-rms-documents": "documents",
        "hlfd-rms-neris-fire-reports": "neris",
        "hlfd-rms-dd-displays": "signage",
        "hlfd-rms-dd-media": "signage",
        "hlfd-rms-dd-playlists": "signage",
        "hlfd-rms-dd-schedules": "signage"
      }.get(listKey, "");
    }
    function listGroupKeys(group) {
      return group == "personnel" ? ["editPersonnel", "manageUsers", "manageSystemSettings"]
        : group == "certifications" ? ["editCertifications", "editPersonnel"]
        : group == "training" ? ["editTraining"]
        : group == "schedule" ? scheduleManageKeys()
        : group == "timeCards" ? ["editSchedule", "manageSystemSettings"]
        : group == "dailyLog" ? ["editDailyLog"]
        : group == "apparatus" ? ["editApparatus", "editFleetAssets", "manageFleetConfig"]
        : group == "assets" ? ["editAssets"]
        : group == "workOrders" ? ["editApparatus", "editFleetWorkOrders"]
        : group == "hoseTests" ? ["editApparatus", "editAssets"]
        : group == "occupancies" ? ["editInspections", "conductInspections", "editPreplans", "createPreplans"]
        : group == "inspections" ? inspectionWorkKeys()
        : group == "preplans" ? preplanWorkKeys()
        : group == "documents" ? ["editDocuments"]
        : group == "neris" ? ["editNerisReports"]
        : group == "signage" ? ["editDigitalDashboard", "manageDigitalDashboard"]
        : [];
    }
    function isListManager(departmentId, listKey) {
      return listGroup(listKey) == "" || memberCanAny(departmentId, listGroupKeys(listGroup(listKey)));
    }
    // Private personnel fields live in personnelPrivate/, never in the shared list.
    function personnelPrivateKeys() {
      return ["birthDate", "citizenship", "race", "ethnicity", "gender", "maritalStatus", "socialSecurityNumber",
        "driversLicenseNumber"];
    }
    function noPrivatePersonnelFields(listKey) {
      return listKey != "hlfd-rms-personnel"
        || !request.resource.data.keys().hasAny(personnelPrivateKeys());
    }
    // What a member may change on their own personnel record (My Profile):
    // contact details and emergency contacts. Matches SELF_EDIT_KEYS in
    // src/lib/personnelProfile.js.
    function selfProfileKeys() {
      return ["address", "unitSuite", "city", "state", "zip", "country", "phones", "emails", "phone", "email",
        "languages", "emergency", "emergencyFirstName", "emergencyLastName", "emergencyPhone",
        "emergencyRelationship", "emergencyAddress", "emergencyCity", "emergencyState", "emergencyZip",
        "emergencySameAddress", "emergency2FirstName", "emergency2LastName", "emergency2Phone",
        "emergency2Relationship", "emergency2Address", "emergency2City", "emergency2State", "emergency2Zip",
        "emergency2SameAddress", "nrCertificate", "stateLicenseCertificate", "agencyLicenseCertificate",
        "updatedAt", "_order"];
    }
    function isOwnProfileEdit(departmentId, listKey) {
      return listKey == "hlfd-rms-personnel"
        && myPersonnelId(departmentId) != ""
        && resource.data.get("id", "") == myPersonnelId(departmentId)
        && changedKeys().hasOnly(selfProfileKeys());
    }
    function isDecided(data) {
      return data.get("status", "") in ["Approved", "Denied"];
    }
    // A new request is the member's own. Members not yet linked to a personnel
    // record can't file requests (they'd be able to file as anyone).
    function newIsMine(departmentId) {
      return myPersonnelId(departmentId) != ""
        && request.resource.data.get("personnelId", "") == myPersonnelId(departmentId);
    }
    function storedIsMine(departmentId) {
      return myPersonnelId(departmentId) != ""
        && resource.data.get("personnelId", "") == myPersonnelId(departmentId);
    }
    // Requesters can't approve their own request.
    function notSelfApproval(departmentId) {
      return !storedIsMine(departmentId)
        || !(request.resource.data.get("status", "") == "Approved" && resource.data.get("status", "") != "Approved");
    }
    // Members (not list managers) may add these items.
    function memberItemCreate(departmentId, listKey) {
      return (listKey == "hlfd-rms-leave-requests"
          && memberCanAny(departmentId, ["submitLeaveRequests", "accessEmployeePortal"])
          && newIsMine(departmentId) && !isDecided(request.resource.data))
        || (listKey == "hlfd-rms-shift-trades"
          && memberCanAny(departmentId, ["submitShiftTrades", "accessEmployeePortal"])
          && newIsMine(departmentId) && !isDecided(request.resource.data))
        || (listKey == "hlfd-rms-vacancy-pickups"
          && memberCanAny(departmentId, ["submitVacancyPickups", "accessEmployeePortal"])
          && newIsMine(departmentId) && !isDecided(request.resource.data))
        || (listKey == "hlfd-rms-time-cards"
          && myPersonnelId(departmentId) != ""
          && request.resource.data.get("personnelId", "") == myPersonnelId(departmentId)
          && request.resource.data.get("departmentHeadSignature", "") in [null, ""])
        || listKey == "hlfd-rms-work-orders";
    }
    // Members (not list managers) may make these changes.
    function memberItemUpdate(departmentId, listKey) {
      return (listKey == "hlfd-rms-leave-requests" && leaveMemberUpdate(departmentId))
        || (listKey == "hlfd-rms-shift-trades"
          && myPersonnelId(departmentId) != ""
          && (myPersonnelId(departmentId) in [resource.data.get("personnelId", ""), resource.data.get("coveragePersonnelId", "")]
              || resource.data.get("assignedBattalionChiefIds", []).hasAny([myPersonnelId(departmentId)]))
          && unchanged("personnelId") && notSelfApproval(departmentId))
        || (listKey == "hlfd-rms-call-shifts" && changedKeys().hasOnly(["responses", "updatedAt", "_order"]))
        // Your own time card, until the department head has signed it.
        || (listKey == "hlfd-rms-time-cards"
          && storedIsMine(departmentId) && unchanged("personnelId") && unchanged("departmentHeadSignature")
          && resource.data.get("departmentHeadSignature", "") in [null, ""])
        || (listKey == "hlfd-rms-documents" && changedKeys().hasOnly(["acknowledgements", "updatedAt", "_order"]))
        // A copy of your own certificate (My Profile), nothing else on the record.
        || (listKey == "hlfd-rms-certifications" && storedIsMine(departmentId)
          && changedKeys().hasOnly(["document", "documentUrl", "documentStoragePath", "documentUploadedAt", "updatedAt", "_order"]))
        // A battalion chief's final trade approval notes it on the requester's record.
        || (listKey == "hlfd-rms-personnel" && changedKeys().hasOnly(["activityLog", "updatedAt", "_order"]));
    }
    // ---- Leave approval steps (for members who don't manage the schedule) ----
    // Who a request is routed to; only list managers change it.
    function leaveRoutingKeys() {
      return ["personnelId", "approvalRoute", "assignedOfficer", "assignedOfficerId", "assignedBattalionChief",
        "assignedBattalionChiefId", "assignedApprover", "assignedApproverId", "assignedApproverIds"];
    }
    // The decision itself.
    function leaveDecisionKeys() {
      return ["status", "approvalStage", "autoApproved", "approvedAt", "officerApprovedAt", "officerApprovedBy",
        "battalionApprovedAt", "battalionApprovedBy", "deniedAt", "deniedBy", "decidedBy", "decidedById", "decidedAt",
        "accrualDeducted", "accrualDeductedHours", "accrualType"];
    }
    // The step a request is waiting on (older requests have no approvalStage).
    function leaveStage(data) {
      return data.get("approvalStage", "") != "" ? data.get("approvalStage", "")
        : data.get("status", "") == "Pending Officer Approval" ? "officer"
        : "battalionChief";
    }
    // The requester may edit their pending request but not decide or reroute it.
    // The officer may only pass it on to the Battalion Chief or deny it; the
    // Battalion Chief (or, at the chief step, the Deputy/Fire Chief) decides.
    // Each acts only at their own step.
    function leaveMemberUpdate(departmentId) {
      let me = myPersonnelId(departmentId);
      let stage = leaveStage(resource.data);
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return me != ""
        && !changed.hasAny(leaveRoutingKeys())
        && notSelfApproval(departmentId)
        && (
          (resource.data.get("personnelId", "") == me && !changed.hasAny(leaveDecisionKeys()))
          || (stage == "officer" && resource.data.get("assignedOfficerId", "") == me
              && request.resource.data.get("status", "") in ["Pending Battalion Chief", "Denied"])
          || (stage == "battalionChief" && resource.data.get("assignedBattalionChiefId", "") == me)
          || (stage == "chief" && me in resource.data.get("assignedApproverIds", [resource.data.get("assignedApproverId", "")]))
        );
    }
    function memberItemDelete(departmentId, listKey) {
      return listKey == "hlfd-rms-leave-requests" && storedIsMine(departmentId) && !isDecided(resource.data);
    }

    // The write moves status into one of these (or creates a record already there).
    function movesToStatus(statuses) {
      return request.resource.data.get("status", "") in statuses
        && (resource == null || resource.data.get("status", "") != request.resource.data.get("status", ""));
    }
    // Fields a write changes (create = every field).
    function changedKeys() {
      return resource == null
        ? request.resource.data.keys()
        : request.resource.data.diff(resource.data).affectedKeys();
    }
    // The write leaves a field as it was (missing on both sides counts as unchanged).
    function unchanged(field) {
      return resource == null
        ? !(field in request.resource.data)
        : !request.resource.data.diff(resource.data).affectedKeys().hasAny([field]);
    }

    function planLimit(departmentId, limitKey) {
      return exists(entitlementsPath(departmentId))
        ? entitlementsData(departmentId).get("limits", {}).get(limitKey, 0)
        : 0;
    }
    function planUsage(departmentId, usageKey) {
      return entitlementsData(departmentId).get("usage", {}).get(usageKey, 0);
    }
    // Room for one more personnel record (0 = unlimited; creators exempt).
    function personnelRoom(departmentId) {
      return isPlatformCreator()
        || planLimit(departmentId, "maxPersonnel") == 0
        || planUsage(departmentId, "personnel") < planLimit(departmentId, "maxPersonnel");
    }
    // A list of n entries fits the limit, or does not grow past what is already there.
    function withinLimit(departmentId, limitKey, newSize, oldSize) {
      return isPlatformCreator()
        || planLimit(departmentId, limitKey) == 0
        || newSize <= planLimit(departmentId, limitKey)
        || newSize <= oldSize;
    }
    // BEGIN generated module maps (functions/lib/moduleCatalog.js; checked by tests/unit/moduleCatalog.test.mjs)
    function listModule(listKey) {
      return {
        "hlfd-rms-personnel": "personnel",
        "hlfd-rms-certifications": "certifications",
        "hlfd-rms-training": "training",
        "hlfd-rms-schedule-days": "scheduling",
        "hlfd-rms-roster": "scheduling",
        "hlfd-rms-leave-requests": "scheduling",
        "hlfd-rms-overtime-offers": "scheduling",
        "hlfd-rms-vacancy-pickups": "scheduling",
        "hlfd-rms-shift-trades": "scheduling",
        "hlfd-rms-call-shifts": "scheduling",
        "hlfd-rms-time-cards": "timeSheets",
        "hlfd-rms-daily-logs": "dailyLog",
        "hlfd-rms-apparatus": "apparatus",
        "hlfd-rms-assets": "assets",
        "hlfd-rms-work-orders": "maintenance",
        "hlfd-rms-hose-tests": "hoseTesting",
        "hlfd-rms-occupancies": "occupancies",
        "hlfd-rms-inspections": "inspections",
        "hlfd-rms-preplans": "preplans",
        "hlfd-rms-documents": "documents",
        "hlfd-rms-neris-fire-reports": "nerisFireReports",
        "hlfd-rms-dd-displays": "digitalDashboard",
        "hlfd-rms-dd-media": "digitalDashboard",
        "hlfd-rms-dd-playlists": "digitalDashboard",
        "hlfd-rms-dd-schedules": "digitalDashboard"
      }.get(listKey, "");
    }
    function collectionModule(collection) {
      return {
        "personnel": "personnel",
        "certifications": "certifications",
        "training": "training",
        "apparatus": "apparatus",
        "assets": "assets",
        "occupancies": "occupancies",
        "documents": "documents",
        "incidents": "nerisFireReports",
        "internalEmails": "internalEmail",
        "dashboardConfig": "digitalDashboard",
        "hydrants": "hydrants",
        "hydrantInspections": "hydrants",
        "hydrantFlowTests": "hydrants",
        "dailyActivity": "hydrants",
        "damageForms": "hydrants",
        "waterCompanies": "hydrants",
        "waterCompanyContacts": "hydrants",
        "waterDistricts": "hydrants",
        "hydrantOwnershipReview": "hydrants",
        "hydrantDamageReports": "hydrants",
        "hydrantDamageEmailAttempts": "hydrants",
        "hydrantDamageAcknowledgments": "hydrants",
        "hydrantRepairVerifications": "hydrants",
        "hydrantDamageAuditEvents": "hydrants",
        "violationCatalog": "inspections",
        "violations": "inspections",
        "codeSets": "inspections",
        "codeSections": "inspections",
        "localAmendments": "inspections",
        "adoptedCodeProfiles": "inspections",
        "codeSavedSections": "inspections",
        "codeSearchHistory": "inspections",
        "codeExtractionIssues": "inspections",
        "fireProtectionSystems": "inspections"
      }.get(collection, "");
    }
    // END generated module maps

    // Which modules are switched off decides what a department can use: platform creators only.
    function enabledModulesUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["disabledModules", "enabledModules"]);
    }

    function subscriptionFieldUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["subscription"]);
    }

    match /platformCreators/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false;
    }

    // Platform-level audit trail (creator console actions). Append-only.
    match /platformAuditLogs/{logId} {
      allow read, create: if isPlatformCreator();
      allow update, delete: if false;
    }

    // Billing reminders / past-due / renewal log written by the daily
    // billingLifecycleDaily function. Creators only.
    match /platformBillingEvents/{eventId} {
      allow read: if isPlatformCreator();
      allow write: if false;
    }

    // Department invites: created/revoked/accepted only by Cloud Functions
    // (functions/lib/invites.js). Department admins can list their own.
    match /invites/{inviteId} {
      allow read: if isAuthenticated() && isDepartmentAdmin(resource.data.departmentId);
      allow write: if false;
    }

    match /platformDepartments/{departmentId} {
      // Public read so signed-out login can show the correct department name/logo.
      allow read: if true;
      allow create, update: if isPlatformCreator()
        || (isDemoAccount() && isDemoDepartment(departmentId));
      allow delete: if false;
    }

    match /platformConfig/{document} {
      allow read: if isAuthenticated();
      allow write: if isPlatformCreator();
    }

    // The platform's public look (logo, name, tagline) for the signed-out
    // "Find Your Department" and sign-in pages. Copied from platformConfig on save.
    match /platformBranding/{document} {
      allow read: if true;
      allow write: if isPlatformCreator();
    }

    match /platformSubscriptionPlans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isPlatformCreator();
    }

    match /platformEntitlements/{departmentId} {
      allow read: if isAuthenticated()
        && (isPlatformCreator() || canAccessDepartment(departmentId) || isDepartmentMember(departmentId));
      allow write: if false;
    }

    match /platformSubscriptions/{departmentId} {
      allow read: if isAuthenticated() && (isPlatformCreator() || canAccessDepartment(departmentId));
      allow write: if isPlatformCreator();
    }

    // Platform IFC / code library (Creator-managed publications).
    match /codePublications/{publicationId} {
      allow read: if isAuthenticated();
      allow write: if isPlatformCreator();
    }
    match /codeNodes/{nodeId} {
      allow read: if isAuthenticated();
      allow write: if isPlatformCreator();
    }
    match /codeImportBatches/{batchId} {
      allow read: if isAuthenticated() && isPlatformCreator();
      allow write: if isPlatformCreator();
    }
    match /departmentCodeLibraryAccess/{departmentId} {
      allow read: if isAuthenticated() && (isPlatformCreator() || canAccessDepartment(departmentId));
      allow write: if isPlatformCreator();
    }

    match /rmsGateways/{gatewayId} {
      allow read: if true;
      allow create, update: if isPlatformCreator();
      allow delete: if false;
    }

    // ---- Legacy top-level collections (pre-multi-tenant) -------------------
    // Horn Lake's original data lived at the top level. Until it is moved under
    // departments/horn-lake-fd (Phase 2), only Horn Lake members and platform
    // creators may read it, and only creators may write it.
    function canReadLegacyHornLakeData() {
      return canAccessDepartment("horn-lake-fd");
    }

    // Shared reference pointer docs (seeded by scripts with the Admin SDK).
    match /appData/{document} {
      allow read: if isAuthenticated();
      allow write: if isPlatformCreator();
    }

    // Shared reference libraries used by every department.
    match /{collection}/{document} {
      allow read: if isAuthenticated() && collection in [
        "emsProtocolsFull",
        "fireCodesFull",
        "fireCodeIndexFull",
        "fireCodePdfSections",
        "fireCodeDocxSections"
      ];
      allow read: if canReadLegacyHornLakeData() && collection in [
        "fireSogsFull",
        "fireSogDetails",
        "hoseInventory"
      ];
      allow write: if isPlatformCreator() && collection in [
        "emsProtocolsFull",
        "fireSogsFull",
        "fireSogDetails",
        "fireCodesFull",
        "fireCodeIndexFull",
        "fireCodePdfSections",
        "fireCodeDocxSections",
        "hoseInventory"
      ];
    }

    // Retired archive of Horn Lake's pre-multi-tenant lists. Horn Lake's data now
    // lives in departments/horn-lake-fd; nothing in the app reads this. Closed to
    // all clients (still readable with the Admin SDK / Firebase console).
    match /rmsData/{document} {
      allow read, write: if false;
    }

    // Unused.
    match /integrationSettings/{document} {
      allow read, write: if false;
    }

    match /academyTrainingSyncLog/{document} {
      allow read, write: if false;
    }

    // Station TV screens no longer read these lists directly: they go through
    // alertDashboardPublicView with the department display key (2026-10-29).
    function isPublicAlertList(listKey) {
      return listKey in [
        "hlfd-rms-active911-alerts",
        "hlfd-rms-alert-dashboard-config",
        "hlfd-rms-alert-business-directory",
        "hlfd-rms-dd-displays"
      ];
    }

    // Every tenant collection that has its own explicit rule below. The tenant catch-all
    // must not apply to these, otherwise it would override their stricter rules
    // (Firestore allows a request if ANY matching rule allows it).
    // Kept in sync by tests/rules/firestore.rules.test.mjs.
    function hasExplicitTenantRule(collection) {
      return collection in [
        "academyAuditLogs", "academyEvents", "academyIntegrations", "adoptedCodeProfiles",
        "auditLogs", "codeExtractionIssues", "codeSavedSections", "codeSearchHistory", "counters",
        "internalEmails", "memberGrants", "personnelPrivate", "preplanRestricted",
        "codeSections", "codeSets", "dropdowns", "fireProtectionSystems",
        "fleetAccidentEvents", "fleetAssetAliases", "fleetAssetInsurance", "fleetAssets",
        "fleetAssignments", "fleetAuditEvents", "fleetAutomationRuns", "fleetAutomations",
        "fleetBatteries", "fleetBuildProjects", "fleetCadMappings", "fleetCapitalPlanItems",
        "fleetChargingSessions", "fleetChecklistTemplateVersions", "fleetChecklistTemplates", "fleetCheckouts",
        "fleetChecks", "fleetClasses", "fleetCostEntries", "fleetDeconEvents",
        "fleetDefectCategories", "fleetDefects", "fleetDisposalRecords", "fleetDowntimeEvents",
        "fleetFluidEvents", "fleetFuelExceptionRules", "fleetFuelSites", "fleetFuelTransactions",
        "fleetGrants", "fleetHardeningChecks", "fleetInsuranceClaims", "fleetIntegrationAdapters",
        "fleetLoadPlans", "fleetMeterReadings", "fleetMigrationReports", "fleetNerisMappings",
        "fleetPmPrograms", "fleetPmSchedules", "fleetPoolReservations", "fleetProcurementRequests",
        "fleetRecalls", "fleetReplacementCases", "fleetReplacementModels", "fleetReportRuns",
        "fleetReserveRequests", "fleetReserveSwaps", "fleetRoadsideEvents", "fleetSafetyReviews",
        "fleetSavedReports", "fleetSettings", "fleetShops", "fleetSpecifications",
        "fleetStatusEvents", "fleetTelematicsAdapters", "fleetTelematicsEvents", "fleetTelematicsMappings",
        "fleetTestPrograms", "fleetTests", "fleetTires", "fleetTowProviders",
        "fleetTransfers", "fleetValuations", "fleetVendors", "fleetWarranties",
        "fleetWarrantyClaims", "fleetWorkOrders", "fleetWorkflows", "fpsContractors",
        "fpsDeficiencies", "fpsImpairments", "fpsTestReports", "hydrantDamageAcknowledgments",
        "hydrantDamageAuditEvents", "hydrantDamageEmailAttempts", "hydrantDamageReports", "hydrantOwnershipReview",
        "hydrantRepairVerifications", "inspectionAppeals", "inspectionAuditEvents", "inspectionAutomationRuns",
        "inspectionAutomations", "inspectionCalendarEvents", "inspectionCertificates", "inspectionCitations",
        "inspectionCorrectionSubmissions", "inspectionDevicePolicies", "inspectionDocumentTemplates", "inspectionEnforcementOrders",
        "inspectionFeeAdjustments", "inspectionFeeSchedules", "inspectionFees", "inspectionHardeningChecks",
        "inspectionImportBatches", "inspectionIntegrationAdapters", "inspectionInvoices", "inspectionNerisMappings",
        "inspectionNoticeDeliveries", "inspectionNotices", "inspectionPayments", "inspectionReinspections",
        "inspectionReportRuns", "inspectionSavedReports", "inspectionScheduledReports", "inspectionSettings",
        "inspectionTemplateVersions", "inspectionTemplates", "inspectionTypes", "inspectionWebhooks",
        "inspectionWorkflows", "inspections", "integrations", "lists",
        "localAmendments", "notifications", "occupancies", "people",
        "preplanBuildings", "preplanDiagrams", "preplanDropdownLibraries", "preplanDropdownOptions",
        "preplanFiles", "preplanQrTokens", "preplanRevisions", "preplanSymbolLibraries",
        "preplanTemplateVersions", "preplanTemplates", "preplanVerifications", "preplans",
        "profile", "public", "roles", "settings",
        "users", "violationCatalog", "violations", "waterCompanies",
        "waterCompanyContacts", "waterDistricts",
        "fieldCheckoffLists", "fieldCheckoffs", "fieldPlanUpdates",
        "hydrants", "hydrantInspections", "hydrantFlowTests", "dailyActivity",
        "heatZoneAccess", "heatZoneCalls", "heatZoneEvents", "heatZoneGeocodes", "heatZoneMeta", "heatZoneSettings", "heatZoneZones"
      ];
    }

    match /departments/{departmentId} {
      match /public/{document} {
        allow read: if document == "alert-dashboard";
        allow write: if canAccessDepartment(departmentId)
          && memberCanAny(departmentId, ["manageDigitalDashboard", "manageSystemSettings"]);
      }
      match /profile/{document} {
        // Members of a suspended department may still read the profile so the app
        // can show them a "subscription inactive" message.
        allow read: if canAccessDepartment(departmentId) || isDepartmentMember(departmentId);
        // Stations cannot grow past the plan's maxStations.
        allow create: if canAccessDepartment(departmentId)
          && withinLimit(departmentId, "maxStations", request.resource.data.get("stationDetails", []).size(), 0)
          && withinLimit(departmentId, "maxStations", request.resource.data.get("stations", []).size(), 0);
        allow update: if canAccessDepartment(departmentId)
          && memberCanAny(departmentId, ["manageSystemSettings"])
          && withinLimit(departmentId, "maxStations",
               request.resource.data.get("stationDetails", []).size(), resource.data.get("stationDetails", []).size())
          && withinLimit(departmentId, "maxStations",
               request.resource.data.get("stations", []).size(), resource.data.get("stations", []).size());
        allow delete: if isPlatformCreator();
      }
      // Department settings: admins change them. A member may only seed a missing
      // settings/main on first load and save distribution groups (the app checks
      // manageInternalEmail). Secrets live in integrations/, never here.
      match /settings/{document} {
        allow read: if canAccessDepartment(departmentId);
        allow create: if isDepartmentAdmin(departmentId)
          || (document == "main" && canAccessDepartment(departmentId));
        allow update: if (
            isDepartmentAdmin(departmentId)
            || (canAccessDepartment(departmentId) && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["internalEmailGroups", "departmentId", "updatedAt"]))
          )
          && (isPlatformCreator() || (subscriptionFieldUnchanged() && enabledModulesUnchanged()));
        // FORGE FIELD settings (settings/fieldApp) are admin-only through the rule above.
      }
      // FORGE FIELD: EMS unit / supply closet check-off lists (built by admins)
      // and the counts crews submit from the field.
      match /fieldCheckoffLists/{listId} {
        allow read: if canAccessDepartment(departmentId);
        allow create, update: if isDepartmentAdmin(departmentId);
        allow delete: if false;
      }
      match /fieldCheckoffs/{checkoffId} {
        allow read: if canAccessDepartment(departmentId);
        allow create: if canAccessDepartment(departmentId)
          && request.resource.data.get("performedByUid", "") == request.auth.uid;
        // A retried sync rewrites the same check-off; admins mark it restocked.
        allow update: if (canAccessDepartment(departmentId)
            && resource.data.get("performedByUid", "") == request.auth.uid
            && request.resource.data.get("performedByUid", "") == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["restockedAt", "restockedBy"]))
          || (isDepartmentAdmin(departmentId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["restockedAt", "restockedBy", "updatedAt"]));
        allow delete: if false;
      }
      // Pre-fire plan updates sent from the field for review.
      match /fieldPlanUpdates/{updateId} {
        allow read: if canAccessDepartment(departmentId);
        allow create: if canAccessDepartment(departmentId)
          && request.resource.data.get("submittedByUid", "") == request.auth.uid
          && request.resource.data.get("status", "") == "pending";
        allow update: if canAccessDepartment(departmentId)
          && (
            (resource.data.get("submittedByUid", "") == request.auth.uid
              && request.resource.data.get("status", "") == "pending"
              && request.resource.data.get("submittedByUid", "") == request.auth.uid)
            || (isDepartmentAdmin(departmentId) || canWriteModule(departmentId, "preplans"))
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "reviewNote", "reviewedAt", "reviewedBy", "updatedAt"])
          );
        allow delete: if false;
      }
      // A list is either one record holding an items array (older), or a header
      // { storage: "items" } with each item in lists/{listKey}/items/{itemId}.
      // Once a list is per-item, writing an items array onto its header is
      // refused, so an out-of-date app can't save into the old format unseen.
      // Writes also need the list's module switched on, and the personnel list
      // cannot grow past the plan's maxPersonnel.
      match /lists/{listKey} {
        allow read: if canAccessDepartment(departmentId);
        // A whole-list (items array) save changes everyone's records, so it needs
        // the list's manage permission. Headers without items are fine for members.
        allow create: if canWriteModule(departmentId, listModule(listKey))
          && (request.resource.data.get("items", []).size() == 0 || isListManager(departmentId, listKey))
          && (listKey != "hlfd-rms-personnel"
              || withinLimit(departmentId, "maxPersonnel", request.resource.data.get("items", []).size(), 0));
        allow update: if canWriteModule(departmentId, listModule(listKey))
          && !(resource.data.get("storage", "") == "items"
               && request.resource.data.get("items", []).size() > 0)
          && (!changedKeys().hasAny(["items"]) || isListManager(departmentId, listKey))
          && (listKey != "hlfd-rms-personnel"
              || withinLimit(departmentId, "maxPersonnel",
                   request.resource.data.get("items", []).size(), resource.data.get("items", []).size()));
        allow delete: if canWriteModule(departmentId, listModule(listKey)) && isListManager(departmentId, listKey);

        // One record per item. List managers change anything; other members only
        // their own requests/time card, replies and acknowledgements (see memberItem*).
        match /items/{itemId} {
          allow read: if canAccessDepartment(departmentId);
          allow create: if canWriteModule(departmentId, listModule(listKey))
            && (listKey != "hlfd-rms-personnel" || personnelRoom(departmentId))
            && noPrivatePersonnelFields(listKey)
            && (isListManager(departmentId, listKey) || memberItemCreate(departmentId, listKey));
          allow update: if canWriteModule(departmentId, listModule(listKey))
            && noPrivatePersonnelFields(listKey)
            && (isListManager(departmentId, listKey)
                || changedKeys().hasOnly(["_order"])
                || memberItemUpdate(departmentId, listKey)
                || isOwnProfileEdit(departmentId, listKey));
          allow delete: if canWriteModule(departmentId, listModule(listKey))
            && (isListManager(departmentId, listKey) || memberItemDelete(departmentId, listKey));
        }
      }
      // Private personnel fields (SSN, birth date, demographics): people who can
      // see private info, and each person reads their own.
      match /personnelPrivate/{personnelId} {
        allow read: if memberCanAny(departmentId, ["editPersonnel", "manageUsers", "manageSystemSettings"])
          || (canAccessDepartment(departmentId) && myPersonnelId(departmentId) == personnelId);
        allow create, update, delete: if canWriteModule(departmentId, "personnel")
          && memberCanAny(departmentId, ["editPersonnel", "manageUsers", "manageSystemSettings"]);
      }
      // Each member's permissions, written only by Cloud Functions.
      match /memberGrants/{uid} {
        allow read: if (isAuthenticated() && request.auth.uid == uid) || isDepartmentAdmin(departmentId);
        allow write: if false;
      }
      // Record-number counters: only ever count up.
      match /counters/{counterKey} {
        allow read: if canAccessDepartment(departmentId);
        allow create: if canAccessDepartment(departmentId)
          && request.resource.data.keys().hasOnly(["value", "updatedAt"])
          && request.resource.data.value is int && request.resource.data.value > 0;
        allow update: if canAccessDepartment(departmentId)
          && request.resource.data.keys().hasOnly(["value", "updatedAt"])
          && request.resource.data.value is int && request.resource.data.value > resource.data.value;
        allow delete: if false;
      }
      // Memberships: created and changed by department admins (or platform creators) only.
      // Users can never grant themselves access or roles.
      match /users/{userId} {
        allow read: if canAccessDepartment(departmentId) || (isAuthenticated() && request.auth.uid == userId);
        // Department admins add people by invite (createDepartmentInvite checks the
        // plan's portal-user limit); only creators create memberships directly.
        allow create: if isPlatformCreator()
          || (
            // Demo sandbox: the shared demo account may join itself (as Fire Chief by
            // design), but never with platform-creator flags.
            isDemoDepartment(departmentId)
            && isDemoAccount()
            && request.auth.uid == userId
            && !touchesPlatformFlags(request.resource.data)
          );
        allow update: if isPlatformCreator()
          || (isDepartmentAdmin(departmentId) && platformFlagsUnchanged())
          || (isAuthenticated() && request.auth.uid == userId && isSafeSelfMembershipUpdate());
        allow delete: if isPlatformCreator()
          || (isDepartmentAdmin(departmentId) && !touchesPlatformFlags(resource.data));
      }
      match /roles/{roleId} {
        allow read: if canAccessDepartment(departmentId);
        allow write: if isDepartmentAdmin(departmentId);
      }
      match /dropdowns/{dropdownId} {
        allow read: if canAccessDepartment(departmentId);
        // Missing defaults may be created by anyone; changes need manageDropdowns.
        allow create: if canAccessDepartment(departmentId);
        allow update, delete: if canAccessDepartment(departmentId)
          && memberCanAny(departmentId, ["manageDropdowns", "manageSystemSettings"]);
      }
      // Messages: read by the sender, the recipients (toAll / recipientUids, filled
      // in by the internalMessageAudience function) and message managers. Sent as
      // yourself; others only mark them read; sender or message managers delete.
      match /internalEmails/{messageId} {
        allow read: if canAccessDepartment(departmentId)
          && (resource.data.get("fromUid", "") == request.auth.uid
              || resource.data.get("toAll", false) == true
              || request.auth.uid in resource.data.get("recipientUids", [])
              || memberCanAny(departmentId, ["manageInternalEmail"]));
        allow create: if canWriteModule(departmentId, "internalEmail")
          && request.resource.data.get("fromUid", "") == request.auth.uid;
        allow update: if canWriteModule(departmentId, "internalEmail")
          && (
            (resource.data.get("fromUid", "") == request.auth.uid && unchanged("fromUid"))
            || (changedKeys().hasOnly(["readBy", "updatedAt"])
                && request.resource.data.get("readBy", {}).diff(resource.data.get("readBy", {})).affectedKeys().hasOnly([request.auth.uid]))
            || memberCanAny(departmentId, ["manageInternalEmail"])
          );
        allow delete: if canWriteModule(departmentId, "internalEmail")
          && (resource.data.get("fromUid", "") == request.auth.uid || memberCanAny(departmentId, ["manageInternalEmail"]));
      }
      // Heat Zone Analytics (functions/lib/heatZone). Everything is written by Cloud
      // Functions only; analytics are served through callables that check the
      // caller's department membership, permissions and district scope. Browsers
      // may only listen to the change counter, to know when to refresh.
      match /heatZoneMeta/{document} {
        allow read: if canAccessDepartment(departmentId) && memberCanAny(departmentId, ["viewHeatZoneAnalytics"]);
        allow write: if false;
      }
      match /heatZoneCalls/{document} {
        allow read, write: if false;
      }
      match /heatZoneZones/{document} {
        allow read, write: if false;
      }
      match /heatZoneSettings/{document} {
        allow read, write: if false;
      }
      match /heatZoneAccess/{document} {
        allow read, write: if false;
      }
      match /heatZoneEvents/{document} {
        allow read, write: if false;
      }
      match /heatZoneGeocodes/{document} {
        allow read, write: if false;
      }
      match /auditLogs/{logId} {
        allow read: if canAccessDepartment(departmentId);
        allow create: if canAccessDepartment(departmentId);
        allow update, delete: if false;
      }
      match /inspectionSettings/{document} {
        allow read: if canAccessDepartment(departmentId);
        allow create: if canWriteModule(departmentId, "inspections");
        allow update: if canManageModule(departmentId, "inspections", inspectionConfigKeys());
        allow delete: if isPlatformCreator();
      }
      // Signing off an inspection that is awaiting approval needs approveInspections.
      match /inspections/{inspectionId} {
        allow read: if canAccessDepartment(departmentId);
        allow create, update: if canManageModule(departmentId, "inspections", inspectionWorkKeys())
          && !(resource != null && resource.data.get("status", "") == "awaiting_approval"
               && request.resource.data.get("status", "") == "completed"
               && !memberCanAny(departmentId, ["approveInspections", "manageInspectionConfig"]));
        allow delete: if canManageModule(departmentId, "inspections", inspectionWorkKeys());
      }
      match /occupancies/{occupancyId} {
        allow read: if canAccessDepartment(departmentId);
        allow create, update: if canManageModule(departmentId, "occupancies", inspectionWorkKeys());
        allow delete: if canManageModule(departmentId, "occupancies", inspectionWorkKeys());
      }
      match /inspectionAuditEvents/{eventId} {
        allow read: if canAccessDepartment(departmentId);
        allow create: if canManageModule(departmentId, "inspections", inspectionWorkKeys());
        allow update, delete: if false;
      }
      match /inspectionTypes/{typeId} {
        allow read: if canAccessDepartment(departmentId);
        allow create: if canWriteModule(departmentId, "inspections");
        allow update, delete: if canManageModule(departmentId, "inspections", inspectionConfigKeys());
      }
      match /inspectionTemplates/{templateId} {
        allow read: if canAccessDepartment(departmentId);
        allow create: if canWriteModule(departmentId, "inspections");
        allow update, delete: if canManageModule(departmentId, "inspections", inspectionConfigKeys());
      }
      match /inspectionTemplateVersions/{versionId} {
        allow read: if canAccessDepartment(departmentId);
        allow create: if canManageModule(departmentId, "inspections", inspectionWorkKeys());
        // Published versions are immutable snapshots.
        allow update, delete: if false;
      }
      match /codeSets/{codeSetId} {
        allow read: if canAccessDepartment(departmentId);
        allow create: if canWriteModule(departmentId, "inspections");
        allow update, delete: if canManageModule(departmentId, "inspections", codeLibraryKeys());
      }
      match /codeSections/{sectionId} {
        allow read: if canAccessDepartment(departmentId);
        allow create: if canWriteModule(departmentId, "inspections");
        allow update, delete: if canManageModule(departmentId, "inspections", codeLibraryKeys());
      }
      match /localAmendments/{amendmentId} {
        allow read: if canAccessDepartment(departmentId);
        allow create: if canWriteModule(departmentId, "inspections");
        allow update, delete: if canManageModule(departmentId, "inspections", codeLibraryKeys());
      }
      match /adoptedCodeProfiles/{profileId} {
        allow read: if canAccessDepartment(departmentId);
        allow create: if canWriteModule(departmentId, "inspections");
        allow update, delete: if canManageModule(departmentId, "inspections", codeLibraryKeys());
      }
      match /codeSavedSections/{savedId} {
        allow read: if canAccessDepartment(departmentId);
        allow create, update, delete: if canWriteModule(departmentId, "inspections");
      }
      match /codeSearchHistory/{historyId} {
        allow read: if canAccessDepartment(departmentId);
        allow create, update, delete: if canWriteModule(departmentId, "inspections");
      }
      match /codeExtractionIssues/{issueId} {
        allow read: if canAccessDepartment(departmentId);
        allow create: if canWriteModule(departmentId, "inspections");
        allow update, delete: if canManageModule(departmentId, "inspections", codeLibraryKeys());
      }
      match /violationCatalog/{catalogId} {
        allow read: if canAccessDepartment(departmentId);
        allow create: if canWriteModule(departmentId, "inspections");
        allow update, delete: if canManageModule(departmentId, "inspections", inspectionConfigKeys());
      }
      match /violations/{violationId} {
        allow read: if canAccessDepartment(departmentId);
        allow create, update, delete: if canManageModule(departmentId, "inspections", inspectionWorkKeys());
      }
      // Approving or publishing a preplan needs approvePreplans.
      match /preplans/{preplanId} {
        allow read: if canAccessDepartment(departmentId);
        allow create, update: if canManageModule(departmentId, "preplans", preplanWorkKeys())
          && (!movesToStatus(["approved", "published"]) || memberCanAny(departmentId, preplanApproveKeys()));
        allow delete: if canManageModule(departmentId, "preplans", preplanWorkKeys());
      }
      // Restricted preplan answers (gate codes, utility shutoffs, hazmat).
      match /preplanRestricted/{revisionId} {
        allow read: if canAccessDepartment(departmentId) && memberCanAny(departmentId, preplanRestrictedReadKeys());
        allow create, update, delete: if canManageModule(departmentId, "preplans", preplanWorkKeys());
      }
      // Restricted answers (src/lib/inspections/preplanRestricted.js) are kept in
      // preplanRestricted/, never in the revision every member reads.
      match /preplanRevisions/{revisionId} {
        allow read: if canAccessDepartment(departmentId);
        allow create, update: if canManageModule(departmentId, "preplans", preplanWorkKeys())
          && !request.resource.data.get("sectionAnswers", {}).keys().hasAny(["gatesCodes", "gas", "electric", "hazmat"]);
        allow delete: if canManageModule(departmentId, "preplans", preplanWorkKeys());
      }
      match /preplanTemplates/{templateId} {
        allow read: if canAccessDepartment(departmentId);
        allow create: if canWriteModule(departmentId, "preplans");
