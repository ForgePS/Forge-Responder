        allow create: if canWriteModule(departmentId, "hydrants");
        allow update, delete: if false;
      }
      // Fallback for tenant collections without an explicit rule above.
      match /{collection}/{document} {
        allow read: if !hasExplicitTenantRule(collection) && canAccessDepartment(departmentId);
        allow write: if !hasExplicitTenantRule(collection)
          && canWriteModule(departmentId, collectionModule(collection));
      }
    }

    match /hydrantDamageAckTokens/{tokenId} {
      allow read, write: if false;
    }

    // Legacy Horn Lake prototype collections. The app now uses
    // departments/{id}/<same name>; these are kept read-only for Horn Lake
    // until their data is moved (Phase 2), then they will be closed.
    match /preFirePlans/{document} {
      allow read: if canReadLegacyHornLakeData();
      allow write: if isPlatformCreator();
    }

    match /hydrants/{document} {
      allow read: if canReadLegacyHornLakeData();
      allow write: if isPlatformCreator();
    }

    match /hydrantInspections/{document} {
