rules_version = '2';

// Storage access mirrors Firestore department membership.
// Existing files keep working through their tokenized download URLs
// (download tokens bypass these rules), so locking reads down does not
// break images/documents already saved in Firestore records.
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Same source of truth as firestore.rules: platformCreators/{uid} (server-written).
    function isPlatformCreator() {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/platformCreators/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/platformCreators/$(request.auth.uid)).data.status == "active";
    }

    function isDepartmentMember(departmentId) {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/departments/$(departmentId)/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/departments/$(departmentId)/users/$(request.auth.uid)).data.status == "active";
    }

    function canAccessDepartment(departmentId) {
      return isPlatformCreator()
        || isDepartmentMember(departmentId)
        || (isAuthenticated() && departmentId == "forge-demo" && request.auth.token.get("email", "") == "demo@forge.demo");
    }

    // Deleting files needs an editing permission (see firestore.rules memberGrants).
    // Firefighters and Read Only can upload (photos on checks) but not delete.
    function canDeleteFiles(departmentId) {
      return isPlatformCreator()
        || (isAuthenticated() && departmentId == "forge-demo" && request.auth.token.get("email", "") == "demo@forge.demo")
        || (isDepartmentMember(departmentId)
            && firestore.exists(/databases/(default)/documents/departments/$(departmentId)/memberGrants/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/departments/$(departmentId)/memberGrants/$(request.auth.uid))
                 .data.get("permissions", {}).keys().hasAny([
                   "manageSystemSettings", "manageUsers", "editPersonnel", "editCertifications", "editTraining",
                   "editDocuments", "editApparatus", "editAssets", "editFleetAssets", "manageFleetConfig",
                   "editFleetDefects", "editFleetWorkOrders", "editInspections", "editPreplans", "createPreplans",
                   "editHydrants", "editNerisReports", "editDigitalDashboard", "manageDigitalDashboard"]));
    }

    // Who uploaded a file (customMetadata.uploadedBy, set by the app). A new
    // upload may only name the uploader; replacing a file needs the person who
    // uploaded it or an editing permission, so members can't overwrite others' files.
    function namesUploader() {
      return request.resource.metadata == null
        || request.resource.metadata.get("uploadedBy", request.auth.uid) == request.auth.uid;
    }
    function canReplaceFile(departmentId) {
      return canDeleteFiles(departmentId)
        || (resource.metadata != null && resource.metadata.get("uploadedBy", "") == request.auth.uid);
    }

    // The shared demo account can't host large files.
    function isAllowedDemoUpload(departmentId) {
      return departmentId != "forge-demo" || request.resource == null || request.resource.size < 10 * 1024 * 1024;
    }

    // Uploads: max 100 MB (pre-fire plan PDFs, dashboard media).
    function isAllowedUpload() {
      return request.resource == null || request.resource.size < 100 * 1024 * 1024;
    }

    match /departments/{departmentId}/{allPaths=**} {
      allow read: if canAccessDepartment(departmentId);
      // Uploading over an existing file can count as a create, so check for one here too.
      allow create: if canAccessDepartment(departmentId) && isAllowedUpload() && isAllowedDemoUpload(departmentId)
        && namesUploader() && (resource == null || canReplaceFile(departmentId));
      allow update: if canAccessDepartment(departmentId) && isAllowedUpload() && isAllowedDemoUpload(departmentId)
        && namesUploader() && canReplaceFile(departmentId);
      allow delete: if canDeleteFiles(departmentId);
    }

    // Help Desk attachments: helpDesk/{departmentId}/{uid}/{uploadId}/{fileName}.
    // Members add their own files (under 10 MB: images, PDF, text, CSV, JSON); the
    // uploader, FORGE staff and that department's admins can read them. Files are
    // never replaced or deleted from the app.
    function isDepartmentAdmin(departmentId) {
      return isDepartmentMember(departmentId)
        && (firestore.get(/databases/(default)/documents/departments/$(departmentId)/users/$(request.auth.uid)).data.get("role", "") == "department_admin"
          || firestore.get(/databases/(default)/documents/departments/$(departmentId)/users/$(request.auth.uid)).data.get("roleIds", []).hasAny(["fireChief", "itAdmin"]));
    }
    function isHelpDeskUploadType() {
      return request.resource.contentType.matches("image/.*")
        || request.resource.contentType in ["application/pdf", "text/plain", "text/csv", "application/json"];
    }
    match /helpDesk/{departmentId}/{uid}/{uploadId}/{fileName} {
      allow read: if isAuthenticated()
        && (request.auth.uid == uid || isPlatformCreator() || isDepartmentAdmin(departmentId));
      allow create: if isAuthenticated() && request.auth.uid == uid
        && canAccessDepartment(departmentId)
        && resource == null
        && request.resource.size < 10 * 1024 * 1024
        && isHelpDeskUploadType();
      allow update, delete: if false;
    }
    // Reply attachments: helpDeskReplies/{ticketId}/{public|internal}/{uid}/{uploadId}/{fileName}.
    // Whoever can reply adds files; the requester reads only files on public replies.
    function helpDeskTicketData(ticketId) {
      return firestore.get(/databases/(default)/documents/helpDeskTickets/$(ticketId)).data;
    }
    function isHelpDeskTicketStaff(ticketId) {
      return isPlatformCreator() || isDepartmentAdmin(helpDeskTicketData(ticketId).departmentId);
    }
    match /helpDeskReplies/{ticketId}/{visibility}/{uid}/{uploadId}/{fileName} {
      allow read: if isAuthenticated()
        && firestore.exists(/databases/(default)/documents/helpDeskTickets/$(ticketId))
        && (request.auth.uid == uid
          || isHelpDeskTicketStaff(ticketId)
          || (visibility == "public" && helpDeskTicketData(ticketId).requesterUid == request.auth.uid));
      allow create: if isAuthenticated() && request.auth.uid == uid
        && visibility in ["public", "internal"]
        && firestore.exists(/databases/(default)/documents/helpDeskTickets/$(ticketId))
        && (isHelpDeskTicketStaff(ticketId)
          || (visibility == "public" && helpDeskTicketData(ticketId).requesterUid == request.auth.uid))
        && resource == null
        && request.resource.size < 10 * 1024 * 1024
        && isHelpDeskUploadType();
      allow update, delete: if false;
    }

    // Digital Forms uploads: formImports/{departmentId}/{importId}/source.{pdf|png|jpg}.
    // The server creates the import record (departments/{d}/formImports/{importId})
    // and picks the path; only the form manager who started it may upload, once,
    // a PDF/PNG/JPEG under 20 MB of the declared type. Form managers can view the
    // original while reviewing. Files are never replaced; the server deletes them.
    function canManageDigitalForms(departmentId) {
      return isPlatformCreator()
        || isDepartmentAdmin(departmentId)
        || (isDepartmentMember(departmentId)
            && firestore.exists(/databases/(default)/documents/departments/$(departmentId)/memberGrants/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/departments/$(departmentId)/memberGrants/$(request.auth.uid))
                 .data.get("permissions", {}).keys().hasAny(["manageDigitalForms"]));
    }
    function formImportData(departmentId, importId) {
      return firestore.get(/databases/(default)/documents/departments/$(departmentId)/formImports/$(importId)).data;
    }
    match /formImports/{departmentId}/{importId}/{fileName} {
      allow read: if isAuthenticated() && canManageDigitalForms(departmentId);
      allow create: if isAuthenticated()
        && canManageDigitalForms(departmentId)
        && resource == null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType in ["application/pdf", "image/png", "image/jpeg"]
        && fileName.matches("source[.](pdf|png|jpg)")
        && firestore.exists(/databases/(default)/documents/departments/$(departmentId)/formImports/$(importId))
        && formImportData(departmentId, importId).status == "awaiting_upload"
        && formImportData(departmentId, importId).createdBy == request.auth.uid
        && formImportData(departmentId, importId).contentType == request.resource.contentType
        && formImportData(departmentId, importId).uploadPath == "formImports/" + departmentId + "/" + importId + "/" + fileName;
      allow update, delete: if false;
    }

    // Platform-wide branding (creator console logo uploads).
    match /platform/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isPlatformCreator() && isAllowedUpload();
    }

    // Legacy uploads outside departments/ — no new reads or writes.
    // Previously saved download URLs still work via their tokens.
    match /{allPaths=**} {
      allow read: if isPlatformCreator();
      allow write: if false;
    }
  }
}
