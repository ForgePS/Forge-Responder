# Local emulator only — production uses Firebase secrets:
#   firebase functions:secrets:set TWILIO_ACCOUNT_SID
#   firebase functions:secrets:set TWILIO_AUTH_TOKEN
#   firebase functions:secrets:set TWILIO_FROM_NUMBER
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# JotForm damage webhook uses per-department tokens stored in Firestore:
# departments/{departmentId}/settings/damageFormJotform.webhookToken
