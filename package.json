{
  "name": "forge-public-safety-rms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test:nav": "node scripts/test-prevention-nav.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "migrate:tenant": "node scripts/migrate-horn-lake-to-tenant.mjs",
    "migrate:tenant:dry-run": "node scripts/migrate-horn-lake-to-tenant.mjs --dry-run",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "deploy:firestore-rules": "firebase deploy --only firestore:rules",
    "seed:user": "node scripts/seed-department-user.mjs",
    "seed:creator": "node scripts/seed-platform-creator.mjs",
    "seed:platform-config": "node scripts/seed-platform-config.mjs",
    "seed:demo": "node scripts/seed-demo-department.mjs",
    "seed:gateways": "node scripts/seed-rms-gateways.mjs",
    "sync:neris-schema": "node scripts/sync-neris-schema.mjs",
    "import:neris-xlsx": "node scripts/import-neris-xlsx.mjs",
    "push:test-alert": "node functions/scripts/pushTestAlert.js",
    "fleet:load-smoke": "node scripts/fleet-load-smoke.mjs",
    "ifc:parse": "node scripts/ifc/parseIfcDocx.mjs",
    "ifc:publish": "node scripts/ifc/publishIfcLibrary.mjs",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-forge-rms \"node --test tests/rules/firestore.rules.test.mjs\"",
    "build:staging": "vite build --mode staging",
    "deploy:staging:rules": "firebase deploy --only firestore:rules,storage --project staging",
    "backfill:memberships": "node scripts/backfill-memberships.mjs",
    "backfill:memberships:apply": "node scripts/backfill-memberships.mjs --apply",
    "test:functions": "firebase emulators:exec --only firestore,storage --project demo-forge-rms \"node --test --test-concurrency=1 tests/functions/invites.test.mjs tests/functions/billing.test.mjs tests/functions/platformConsole.test.mjs tests/functions/listStore.test.mjs tests/functions/entitlements.test.mjs tests/functions/twoFactor.test.mjs\"",
    "inventory:legacy": "node scripts/inventory-legacy-data.mjs",
    "cleanup:phase2": "node scripts/phase2-cleanup.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:field-offline": "node scripts/field-e2e/field-offline.mjs",
    "test": "npm run test:unit && npm run test:rules && npm run test:functions",
    "lint": "eslint src",
    "dev:emulator": "vite --mode emulator",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-forge-rms",
    "deploy:staging": "firebase deploy --only hosting,functions,firestore:rules,firestore:indexes,storage --project staging",
    "seed:staging": "node scripts/seed-staging.mjs"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "1.17.0",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "firebase-admin": "^13.4.0",
    "firebase-tools": "15.22.4",
    "globals": "15.15.0",
    "vite": "8.0.16"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
