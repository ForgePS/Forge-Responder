# Local testing against the Firebase emulators (npm run emulators, then npm run dev:emulator).
# Fake values: the emulators accept any key, and "demo-" projects can never reach real Firebase.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-forge-rms.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-forge-rms
VITE_FIREBASE_STORAGE_BUCKET=demo-forge-rms.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_USE_FIREBASE_EMULATORS=true

# Offline demo (npm run demo:offline). The shared demo login exists only on the local emulators.
VITE_DEMO_EMAIL=demo@forge.demo
VITE_DEMO_PASSWORD=ForgeOfflineDemo-local
VITE_RMS_APP_URL=http://localhost:4173
# Keep the real project's online-only keys out of local builds.
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_PIXABAY_API_KEY=

# Local-only test creator for the auth emulator (never a real account).
# EMULATOR_TEST_CREATOR_EMAIL=creator@forge.test
# EMULATOR_TEST_CREATOR_PASSWORD=Emu-a9345a9fadc9
